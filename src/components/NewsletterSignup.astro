---
// Newsletter signup, posts directly to Buttondown — no JS, no backend function.
//
// SETUP (one-time):
// 1. Create a free account at https://buttondown.com
// 2. Replace YOUR_BUTTONDOWN_USERNAME below (two spots: action + onsubmit) with
//    your actual Buttondown username.
// That's it — Buttondown hosts the subscriber list and confirmation email.

interface Props {
  heading?: string;
  subhead?: string;
}

const {
  heading = 'Get new posts by email',
  subhead = "One-off notes when a new study-mantra check-up goes up. No spam, unsubscribe anytime.",
} = Astro.props;

const BUTTONDOWN_USERNAME = 'equitydriftpoker';
---

<div class="newsletter">
  <p class="heading">{heading}</p>
  <p class="subhead">{subhead}</p>
  <form
    action={`https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_USERNAME}`}
    method="post"
    target="popupwindow"
    onsubmit={`window.open('https://buttondown.com/${BUTTONDOWN_USERNAME}', 'popupwindow')`}
    class="signup-form"
  >
    <label class="sr-only" for="bd-email">Email address</label>
    <input type="email" name="email" id="bd-email" placeholder="you@email.com" required />
    <input type="hidden" value="1" name="embed" />
    <button type="submit">Subscribe</button>
  </form>
</div>

<style>
  .newsletter {
    background: rgba(9, 6, 18, 0.4);
    border: 1px solid rgba(232, 178, 63, 0.35);
    border-radius: 10px;
    padding: 1.75rem clamp(1.25rem, 4vw, 2.25rem);
    margin: 2.5rem 0;
  }
  .heading {
    margin: 0 0 0.35rem;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    color: var(--ink);
    font-size: 1.15rem;
  }
  .subhead {
    margin: 0 0 1.25rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .signup-form {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .signup-form input[type='email'] {
    flex: 1 1 14rem;
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.65rem 1.1rem;
    color: var(--ink);
    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
  }
  .signup-form input[type='email']::placeholder { color: var(--ink-dim); }
  .signup-form input[type='email']:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .signup-form button {
    background: var(--gold);
    color: var(--felt-deep);
    border: none;
    border-radius: 999px;
    padding: 0.65rem 1.4rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }
  .signup-form button:hover { background: var(--gold-soft); }
  .signup-form button:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
