---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Equity Drift"
  description="Pot-Limit Omaha study notes: testing strategy mantras against real hand data, one filter at a time."
>
  <main class="home">
    <section class="hero">
      <p class="eyebrow mono">PLO, hand by hand</p>
      <h1>The mantra says one thing. The database says another.</h1>
      <p class="dek">
        Every post starts with a piece of table wisdom — a habit, a rule of thumb, a thing your
        coach said once — then runs it against real hand history to see if it survives contact
        with the data.
      </p>
    </section>

    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}/`}>
            <h2>{post.data.title}</h2>
            <p class="mono meta">
              {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric', month: 'long', day: 'numeric',
              })}
            </p>
            <p class="excerpt">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>

<style>
  .home { max-width: 50rem; margin: 0 auto; padding: 4rem 1.5rem 5rem; }

  .hero {
    padding: 2.75rem clamp(1.5rem, 4vw, 3.5rem);
    margin-bottom: 2.5rem;
  }
  .eyebrow {
    font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--cyan); margin: 0 0 0.9rem; font-family: 'IBM Plex Mono', monospace;
  }
  .hero h1 {
    font-size: clamp(2.1rem, 4.4vw, 3.1rem); margin: 0 0 1rem; line-height: 1.08;
    color: var(--ink);
  }
  .dek { color: var(--ink-soft); font-size: 1.15rem; max-width: 34rem; }

  .post-list {
    list-style: none; margin: 0; padding: 0;
    background: var(--panel);
    border: 1px solid var(--felt-line);
    border-radius: 10px;
    box-shadow: 0 30px 70px -30px rgba(4, 2, 10, 0.75);
    overflow: hidden;
  }
  .post-list li {
    border-top: 1px solid var(--felt-line);
    border-left: 3px solid transparent;
    padding: 2rem clamp(1.5rem, 4vw, 3rem);
    transition: border-color 0.15s ease;
  }
  .post-list li:first-child { border-top: none; }
  .post-list li:hover { border-left-color: var(--cyan); }
  .post-list a { text-decoration: none; color: inherit; display: block; }
  .post-list h2 {
    font-size: 1.4rem; margin: 0 0 0.4rem; color: var(--ink);
  }
  .post-list a:hover h2 { color: var(--gold); }
  .meta { font-size: 0.7rem; color: var(--ink-dim); margin: 0 0 0.6rem; font-family: 'IBM Plex Mono', monospace; }
  .excerpt { margin: 0; color: var(--ink-soft); }
</style>
