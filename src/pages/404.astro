---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist on Equity Drift.">
  <main class="not-found" id="main-content">
    <p class="eyebrow mono">Bad beat</p>
    <h1>This page didn't survive contact with the data.</h1>
    <p class="dek">
      Whatever you were looking for isn't here — the link may be old, or it never
      existed. Head back to the posts, or browse by tag.
    </p>
    <div class="actions">
      <a class="btn" href="/">Back to posts</a>
      <a class="btn ghost" href="/tags/">Browse tags</a>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found {
    max-width: 36rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
    text-align: center;
  }
  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 1rem;
    font-family: 'IBM Plex Mono', monospace;
  }
  h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin: 0 0 1rem;
    line-height: 1.25;
  }
  .dek {
    color: var(--ink-soft);
    font-size: 1.05rem;
    margin: 0 0 2.5rem;
  }
  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    background: var(--gold);
    color: var(--felt-deep);
  }
  .btn.ghost {
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--ink-soft);
    font-weight: normal;
  }
  .btn.ghost:hover {
    border-color: var(--cyan);
    color: var(--cyan);
  }
</style>
