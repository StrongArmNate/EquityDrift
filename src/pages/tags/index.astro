---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { tagSlug } from '../../utils/tags';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const counts = new Map<string, { label: string; count: number }>();

for (const post of posts) {
  for (const tag of post.data.tags) {
    const slug = tagSlug(tag);
    const entry = counts.get(slug);
    if (entry) entry.count += 1;
    else counts.set(slug, { label: tag, count: 1 });
  }
}

const tags = Array.from(counts.entries())
  .map(([slug, { label, count }]) => ({ slug, label, count }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
---

<BaseLayout title="Tags" description="Browse Equity Drift posts by topic.">
  <main class="tags-index" id="main-content">
    <section class="hero">
      <p class="eyebrow mono">Browse</p>
      <h1>All tags</h1>
      <p class="dek">Every study mantra tested so far, grouped by topic.</p>
    </section>

    {tags.length === 0 ? (
      <p class="empty">No tagged posts yet.</p>
    ) : (
      <ul class="tag-grid">
        {tags.map(({ slug, label, count }) => (
          <li>
            <a href={`/tags/${slug}/`}>
              <span class="tag-name">#{label}</span>
              <span class="tag-count mono">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</BaseLayout>

<style>
  .tags-index { max-width: 50rem; margin: 0 auto; padding: 4rem 1.5rem 5rem; }
  .hero { padding: 2.75rem clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 1rem; }
  .eyebrow {
    font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--cyan); margin: 0 0 0.9rem; font-family: 'IBM Plex Mono', monospace;
  }
  .hero h1 { font-size: clamp(2rem, 4vw, 2.8rem); margin: 0 0 1rem; color: var(--ink); }
  .dek { color: var(--ink-soft); font-size: 1.1rem; }
  .empty { color: var(--ink-soft); padding: 0 clamp(1.5rem, 4vw, 3.5rem); }

  .tag-grid {
    list-style: none; margin: 0; padding: 0 clamp(1.5rem, 4vw, 3.5rem);
    display: flex; flex-wrap: wrap; gap: 0.75rem;
  }
  .tag-grid a {
    display: flex; align-items: center; gap: 0.55rem;
    background: var(--panel-raised);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.55rem 1.1rem;
    text-decoration: none;
    color: var(--cyan);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .tag-grid a:hover { border-color: var(--gold); color: var(--gold); }
  .tag-name { font-size: 0.95rem; }
  .tag-count { font-size: 0.75rem; color: var(--ink-dim); }
</style>
